# IntelliJ, VS Code, Eclipse đều đọc file này -> cả nhóm cùng encoding, line ending, indent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
